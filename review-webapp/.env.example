# setup.ps1 creates .env with random passwords. Do not publish your real .env.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=scx_review
DB_USER=scx_app
DB_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
ADMIN_PASSWORD=replace-with-an-admin-password
REVIEWER_PASSWORD=replace-with-a-reviewer-password
APP_HOST=127.0.0.1
APP_PORT=8088
COOKIE_SECURE=false
